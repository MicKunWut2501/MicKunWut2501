# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server only: cron routes

# Vercel cron protection: Vercel sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=change-me

# Receipt extraction + weekly brief (optional; app works without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
RECEIPT_EXTRACTOR=anthropic               # anthropic | none

# Shown in WhatsApp drafts
NEXT_PUBLIC_FLEET_NAME=Frota Luanda

# Local SQL tests only (scratch database, gets reset)
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet_test
